{
  "name": "spatial-ide",
  "private": true,
  "type": "module",
  "bin": {
    "spatial": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "docs": "typedoc",
    "docs:check": "node scripts/docs-check.ts",
    "check": "npm run typecheck && npm test && npm run docs:check",
    "server": "node src/server/main.ts",
    "web": "vite",
    "build:web": "vite build",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@lezer/common": "^1.5.3",
    "@lezer/cpp": "^1.1.6",
    "@lezer/css": "^1.3.8",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  }
}
