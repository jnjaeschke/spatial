{
  "type": "object",
  "additionalProperties": false,
  "required": ["links", "unmapped"],
  "properties": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "kind", "ranges", "note"],
        "properties": {
          "step": { "type": "string", "description": "A step number exactly as written in brackets in the step list, e.g. \"4.2\"." },
          "kind": { "type": "string", "enum": ["implements", "partial", "structural", "deviates"] },
          "ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "side", "start", "end"],
              "properties": {
                "path": { "type": "string" },
                "side": { "type": "string", "enum": ["new", "old"], "description": "\"old\" only for removed lines, marked (old)." },
                "start": { "type": "integer" },
                "end": { "type": "integer" }
              }
            }
          },
          "note": { "type": "string", "description": "One short sentence; for deviates, what differs from the step." }
        }
      }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ranges", "reason", "note"],
        "properties": {
          "ranges": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "side", "start", "end"], "properties": { "path": { "type": "string" }, "side": { "type": "string", "enum": ["new", "old"] }, "start": { "type": "integer" }, "end": { "type": "integer" } } } },
          "reason": { "type": "string", "enum": ["plumbing", "error-path", "test", "unexplained"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
