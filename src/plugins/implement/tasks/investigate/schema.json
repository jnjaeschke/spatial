{
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "summary", "bug", "locations", "testCases", "architecture", "steps", "openQuestions", "exploration", "specUrls"],
  "properties": {
    "kind": { "type": "string", "enum": ["bugfix", "feature", "spec", "refactor", "perf"] },
    "summary": { "type": "string" },
    "bug": { "type": ["integer", "null"] },
    "locations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "line", "quote", "why", "step"], "properties": { "path": { "type": "string" }, "line": { "type": "integer" }, "quote": { "type": "string" }, "why": { "type": "string" }, "step": { "type": ["integer", "null"] } } } },
    "testCases": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["description", "expected", "actual", "path"], "properties": { "description": { "type": "string" }, "expected": { "type": "string" }, "actual": { "type": ["string", "null"] }, "path": { "type": ["string", "null"] } } } },
    "architecture": { "type": ["string", "null"] },
    "steps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["title", "message", "intent", "checks"], "properties": { "title": { "type": "string" }, "message": { "type": "string" }, "intent": { "type": "string" }, "checks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "subtests", "command", "goal"], "properties": { "kind": { "type": "string", "enum": ["new-test", "failing-test", "covering-test", "measure"] }, "path": { "type": ["string", "null"] }, "subtests": { "type": "array", "items": { "type": "string" } }, "command": { "type": ["string", "null"] }, "goal": { "type": ["string", "null"] } } } } } } },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "exploration": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["tried", "outcome"], "properties": { "tried": { "type": "string" }, "outcome": { "type": "string" } } } },
    "specUrls": { "type": "array", "items": { "type": "string" } }
  }
}
