        "additionalProperties": false,
        "required": ["anchor", "quote", "category", "severity", "title", "body"],
        "properties": {
          "anchor": { "type": "string" },
          "quote": { "type": ["string", "null"] },
          "category": { "enum": ["correctness", "spec", "tests", "style"] },
          "severity": { "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    }
  }
}
