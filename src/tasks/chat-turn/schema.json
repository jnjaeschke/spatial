{
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "questions", "revisions", "requestMcpServers", "diagram"],
  "properties": {
    "answer": { "type": "string" },
    "questions": { "type": "array", "items": { "type": "string" } },
    "requestMcpServers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Denylisted repo MCP server names the assistant wants to access, one Enable button per entry."
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "quote", "correction"],
        "properties": {
          "message": { "type": ["string", "null"] },
          "quote": { "type": "string" },
          "correction": { "type": "string" }
        }
      }
    },
    "diagram": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "title", "summary", "lanes", "steps", "before"],
          "properties": {
            "commit": { "type": "integer", "minimum": 1 },
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "lanes": { "type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "label", "note"],
              "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "note": { "type": ["string", "null"] } }
            } },
            "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
            "before": { "anyOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/step" } }] }
          }
        }
      ]
    }
  },
  "$defs": {
    "cite": {
      "type": "object", "additionalProperties": false, "required": ["path", "line"],
      "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "identifier", "call", "what", "when", "guard", "phase", "status", "cite"],
      "properties": {
        "from": { "type": "string" }, "to": { "type": "string" }, "identifier": { "type": "string" },
        "call": { "type": "string" }, "what": { "type": "string" },
        "when": { "type": ["string", "null"] }, "guard": { "type": ["string", "null"] }, "phase": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["new", "changed", "existing", "removed"] },
        "cite": { "$ref": "#/$defs/cite" }
      }
    }
  }
}
